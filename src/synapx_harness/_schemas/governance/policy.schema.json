{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapx-harness:schema:governance:policy",
  "title": "Communis Policy",
  "description": "Generic policy shape. Specific invariants are enforced in the validator.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": ["contract_type", "schema_version", "policy_id"],
  "properties": {
    "contract_type": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string"},
    "policy_id": {"type": "string"},
    "ratifiers_required": {"type": "integer"},
    "ratifiers_approved": {"type": "integer"},
    "approval_rule": {"type": "string"},
    "approval_count_required": {"type": "integer"},
    "blocking_issues": {"type": "integer"},
    "blocking_issue_count_required": {"type": "integer"},
    "hash_change_invalidates_approvals": {"type": "boolean"},
    "version_change_invalidates_approvals": {"type": "boolean"},
    "application_source_mutation_allowed": {"type": "boolean"},
    "allowed_output_roots": {"type": "array", "items": {"type": "string"}},
    "forbidden_output_roots": {"type": "array", "items": {"type": "string"}},
    "immutable_roots": {"type": "array", "items": {"type": "string"}},
    "official_code_change_context": {"type": "object"},
    "authoring_and_census_context": {"type": "object"},
    "historical_analysis_context": {"type": "object"},
    "ratification_required": {"type": "boolean"},
    "ratifiers_approved_required": {"type": "integer"},
    "content_hash_match_required": {"type": "boolean"},
    "document_version_match_required": {"type": "boolean"},
    "risk_classes": {"type": "object"}
  }
}
