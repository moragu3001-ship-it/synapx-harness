{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapx-harness:schema:governance:activation_manifest",
  "title": "Communis Activation Manifest",
  "description": "Activation Manifest is bound to a Ratification Receipt and a per-document hash manifest. The legacy single-document_hash/document_version fields are deprecated and absent here.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "contract_type",
    "schema_version",
    "release_candidate_id",
    "release_candidate_version",
    "bundle_sha256",
    "ratification_receipt_ref",
    "documents",
    "ratifiers_approved",
    "blocking_issue_count",
    "activation_status"
  ],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "COMMUNIS_ACTIVATION_MANIFEST"
    },
    "schema_version": {
      "type": "string"
    },
    "release_candidate_id": {
      "type": "string"
    },
    "release_candidate_version": {
      "type": "string"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ratification_receipt_ref": {
      "type": "object",
      "required": ["receipt_id", "receipt_sha256"],
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "properties": {
        "receipt_id": {"type": "string"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "document_version", "document_sha256"],
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "properties": {
          "document_id": {"type": "string"},
          "document_version": {"type": "string"},
          "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "ratifiers_approved": {
      "type": "integer",
      "const": 4
    },
    "blocking_issue_count": {
      "type": "integer",
      "const": 0
    },
    "activation_status": {
      "type": "string",
      "enum": ["PENDING", "ACTIVE", "BLOCKED"]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
