{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapx-harness:schema:review:package_payload_manifest",
  "title": "Package Payload Manifest",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "manifest_scope",
    "payload_file_count",
    "files"
  ],
  "properties": {
    "manifest_scope": {
      "type": "string",
      "const": "ALL_PAYLOAD_EXCEPT_THIS_MANIFEST"
    },
    "payload_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\0]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}